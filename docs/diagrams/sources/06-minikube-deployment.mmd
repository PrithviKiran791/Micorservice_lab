    subgraph mk["Minikube (docker driver, containerd) - namespace resqnet"]
        svcgw["Service api-gateway<br/>NodePort 30080<br/>(the only exposed Service)"] --> gw["Deployment api-gateway x2"]
        gw --> auth["Deployment auth-service x1<br/>ClusterIP :8081"]
        gw --> inc["Deployment incident-service x2<br/>ClusterIP :8082"]
        gw --> resp["Deployment responder-service x1<br/>ClusterIP :8083"]
        gw --> notif["Deployment notification-service x1<br/>ClusterIP :8084"]
        inc --> resp
        inc -.->|"event"| mq["Deployment rabbitmq x1<br/>ClusterIP :5672 / :15672"]
        mq -.->|"event"| notif
        auth --> pg["Deployment postgres x1<br/>ClusterIP :5432<br/>PersistentVolumeClaim 1Gi"]
        inc --> pg
        resp --> pg
        notif --> pg
        disc["Deployment discovery-service x1<br/>ClusterIP :8761 (Eureka)<br/>all app services register here"]
        cfg["ConfigMaps resqnet-config, postgres-init<br/>Secret resqnet-secrets (DEMO values)<br/>injected as environment variables"]
        note1["Every app pod: init container waits for Postgres (and RabbitMQ);<br/>startup, liveness and readiness probes on /actuator/health;<br/>image resqnet/NAME:1.0 loaded with minikube image load"]
    end
