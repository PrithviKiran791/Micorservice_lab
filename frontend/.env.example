# Copy to .env.local if you need to change something. Nothing here is secret.

# Base URL of the API. "/api" is correct everywhere: in production the API gateway serves the pages and the API
# from the same address, and in development the Vite server forwards /api to the gateway.
VITE_API_BASE_URL=/api

# Development only: where the Vite dev server forwards /api requests (the API gateway).
# Start it with:  kubectl -n resqnet port-forward svc/api-gateway 8080:8080
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Map (optional). Defaults to OpenStreetMap. Keep the attribution when you change the tile provider.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
